# Get this from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for search scoring, tailoring, and answer drafting
CLAUDE_MODEL=claude-sonnet-4-6

# Model used for the occasional Pipeline Analyst pass (leave as-is unless you want to save cost)
CLAUDE_ANALYST_MODEL=claude-opus-4-8

# Path to the sqlite db (created automatically on first run)
DB_PATH=data/pipeline.db
